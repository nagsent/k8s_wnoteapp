#!/usr/bin/bash
helm install notes-app ./helm/notes-app
helm upgrade notes-app ./helm/notes-app
####uninstall
helm uninstall notes-app
# add install cert-manger
kubectl apply -f https://github.com/cert-manager/cert-manager/releases/latest/download/cert-manager.yaml
# after all the pods will run
kubectl get pods -n cert-manager
# instal tls
helm upgrade --install notes-app ./helm/notes-app
# after 2 - 3 minutes
kubectl get certificate -n web_app_ns
kubectl get secret notes-app-tls -n web_app_ns
# if sucessful
curl https://notes.local
# install prometheus and grafana
helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
helm repo update

kubectl create namespace monitoring

helm install kube-prometheus-stack prometheus-community/kube-prometheus-stack \
  --namespace monitoring \
  --set grafana.adminPassword="admin123" \
  --set prometheus.prometheusSpec.retention="15d"
# access grafan
kubectl get pods -n monitoring
kubectl port-forward -n monitoring svc/kube-prometheus-stack-grafana 3000:80
curl http://localhost:3000
#user admin/admin123
